generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  uuid      String   @id @default(uuid())
  userId    Int      @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  role      Role     @default(USER)

  @@unique([userId])
}

enum Role {
  USER
  ADMIN
}

model Product {
  uuid      String   @id @default(uuid())
  name      String
  price     Float
  asset     String
  inventory  Inventory[]
}

model Inventory {
  uuid       String   @id @default(uuid())
  quantity   Int
  size       Size

  productId  String
  product    Product  @relation(fields: [productId], references: [uuid])
  @@unique([productId, size])
}

enum Size {
  EXTRA_SMALL
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}
